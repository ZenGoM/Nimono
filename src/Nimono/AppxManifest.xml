<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store公開用のアプリマニフェストファイル -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">

  <!-- パッケージ識別情報 (ユーザー指定の値) -->
  <Identity
    Name="ZenGoM.Nimono"
    Publisher="CN=E2338FF3-89FC-4D73-967C-BC126F7A8857"
    Version="1.0.5.0"
    ProcessorArchitecture="x64" />

  <!-- パッケージのプロパティとロゴ定義 -->
  <Properties>
    <DisplayName>Nimono</DisplayName>
    <PublisherDisplayName>ZenGoM</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!--
      MSIX コンテナは既定で HKCU への書き込みをパッケージ専用ハイブへ隔離する。
      ゴミ箱アイコンの空／満杯の状態は
        HKCU\...\Explorer\CLSID\{645FF040-5081-101B-9F08-00AA002F954E}\DefaultIcon
      の (Default) 値でシェルが管理しているため、隔離されると Explorer に反映されず
      アイコンが更新されない。仮想化を無効化して実 HKCU へ書かせる。
      Windows 10 2004 (10.0.19041.0) 以降でのみ有効。それ未満の OS は
      IgnorableNamespaces により本要素を無視する (アイコンが更新されないだけで動作はする)。
    -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <!-- 動作対象とするWindowsのバージョン -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- リソース言語 (日本語) -->
  <Resources>
    <Resource Language="ja-JP" />
  </Resources>

  <!-- アプリケーションの定義 -->
  <!-- デスクトップブリッジ(FullTrust)アプリとして動作するため EntryPoint は FullTrustApplication とします -->
  <Applications>
    <Application Id="App" Executable="Nimono.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Nimono"
        Description="Nimono"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\Square150x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- 必要な機能権限 (通常のデスクトップアプリの動作に必須の runFullTrust 権限) -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- RegistryWriteVirtualization を disabled にするために必須の制限付き機能 -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
